      "label": "End Date",
      "reqd": 0,
      "in_list_view": 0,
      "description": "Blank = perpetual"
    },
    {
      "fieldname": "installment_count",
      "fieldtype": "Int",
      "label": "Total Instalments",
      "reqd": 0,
      "in_list_view": 0
    },
