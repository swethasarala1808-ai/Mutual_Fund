{
  "name": "SEBI Approval",
  "module": "Mutual Fund",
  "doctype": "DocType",
  "issingle": 0,
  "is_submittable": 0,
  "allow_import": 1,
  "fields": [
    {
      "fieldname": "scheme",
      "fieldtype": "Data",
      "label": "Scheme",
      "reqd": 1,
      "in_list_view": 1,
      "description": "Associated scheme"
    },
    {
      "fieldname": "document_type",
      "fieldtype": "Select",
      "label": "Document Type",
      "reqd": 1,
      "in_list_view": 1,
      "options": "SID\nSAI\nKIM",
      "description": "SID=Scheme Information Document, SAI=Statement of Additional Information"
    },
    {
      "fieldname": "version",
      "fieldtype": "Data",
      "label": "Version",
      "reqd": 1,
      "in_list_view": 0,
      "description": "Document version e.g. v3.2"
    },
    {
      "fieldname": "sb_dates",
      "fieldtype": "Section Break",
      "label": "Dates"
    },
    {
      "fieldname": "approval_date",
      "fieldtype": "Date",
      "label": "SEBI Approval Date",
      "reqd": 0,
      "in_list_view": 0
    },
    {
      "fieldname": "effective_date",
      "fieldtype": "Date",
      "label": "Effective Date",
      "reqd": 0,
      "in_list_view": 0
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "reqd": 0,
      "in_list_view": 1,
      "options": "Draft\nSubmitted\nApproved\nSuperseded",
      "default": "Draft"
    },
    {
      "fieldname": "sb_document",
      "fieldtype": "Section Break",
      "label": "Document"
    },
    {
      "fieldname": "document_file",
      "fieldtype": "Attach",
      "label": "Document File",
      "reqd": 0,
      "in_list_view": 0,
      "description": "PDF of the SID/SAI document"
    }
  ],
  "permissions": [
    {
      "role": "All",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "submit": 0,
      "cancel": 0,
      "amend": 0
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1,
  "autoname": "SEBI-.YYYY.-.#####"
}